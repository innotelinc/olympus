# Secrets + local env (setup.sh copies from .env.example)
.env
.factory-env
.archon/tokens.yaml
.archon/cache/
*.log

# Vendored upstreams — cloned by setup.sh at runtime, never committed
core-modules/*
!core-modules/README.md

# Toolchain + deps
node_modules/
.bun/
.uv/

# Next.js (web/studio) — build output + incremental TS cache
.next/
out/
*.tsbuildinfo
# Studio test fixtures (created and removed per run)
web/studio/tests/.tmp/

# Local SecretOps state: the scoped Cerulean Vault token this stack reads.
# Credential material — the equivalent of .env for the Vault integration.
data/vault/token/
data/vault/init/

# Factory runtime state, never committed
.factory/runs/
.factory/ledger.jsonl
.factory/locks-runtime/
.factory/findings/
.factory/needs-human.md
.factory/escalations.log
.factory/trigger.json
.factory/deployed.json
.factory/deploy-history.log
.factory/STOP
.factory/loop.pid
.factory/assumptions/
.factory/followups/
harness/.results/
.factory/holdout/.results/

# Generated apps — factory output (./builds per .archon/config.yaml)
builds/
build-requests/.cache/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS artifacts
.DS_Store
