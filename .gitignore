# Secrets + local env (setup.sh copies from .env.example)
.env
.factory-env
.archon/tokens.yaml
.archon/cache/
*.log

# Vendored upstreams — cloned by setup.sh at runtime, never committed
core-modules/*
!core-modules/README.md

# Toolchain + deps
node_modules/
.bun/
.uv/

# Next.js (web/studio) — build output + incremental TS cache
.next/
out/
*.tsbuildinfo
# Studio test fixtures (created and removed per run)
web/studio/tests/.tmp/

# Local SecretOps state: the scoped Cerulean Vault token this stack reads.
# Credential material — the equivalent of .env for the Vault integration.
data/vault/token/
data/vault/init/

# Studio's saved-app library (STUDIO_DATA_DIR default). Operator content, not
# source — the container keeps it on a named volume instead.
data/studio/

# Factory runtime state, never committed. All of it is machine-local: the pin
# (`consumer.json`) records an absolute cache path, the rest is loop/ledger/state
# and per-run evidence. Nothing under .factory/ is tracked, so ignore the tree
# rather than listing each artifact and missing the next one.
.factory/

# AI Software Factory — installed runtime. `scripts/factory-pin.sh` runs the
# factory's own installer, which copies its managed files into this checkout.
# They are deployment artifacts, not source, so keep them out of commits.
FACTORY.md
FACTORY_RULES.md
MISSION.md
harness/
# ...but factory/ is shared: APP_SPEC_TEMPLATE.md, doctor.py and trigger.py are
# Olympus's own. Note the installer REPLACES doctor.py and trigger.py with its
# parallel set — doctor.py backs the compose healthcheck — so factory-pin.sh
# refuses to run on a dirty tree and reports what it changed.
factory/*
!factory/APP_SPEC_TEMPLATE.md
!factory/doctor.py
!factory/trigger.py

# Generated apps — factory output (./builds per .archon/config.yaml)
builds/
build-requests/.cache/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# OS artifacts
.DS_Store
