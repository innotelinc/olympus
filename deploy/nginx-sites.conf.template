# olympus-sites — serve the staged static sites from `make site-package`.
#
# A TEMPLATE, not a config: the nginx image runs envsubst over files in
# /etc/nginx/templates/ on start, and compose sets NGINX_ENVSUBST_FILTER to
# SITE_PORT so that `${SITE_PORT}` here is the only substitution performed — an
# unfiltered envsubst would also eat nginx's own `$uri` and blank out try_files.
#
# It replaces the image's default.conf entirely, so nginx listens on exactly one
# port and does not also answer on 80. SITE_PORT must be the same value
# `make site-publish` registers at the edge; if they disagree, publishing succeeds
# and the name answers 502 — so both read the one variable (docs/site-publishing.md).
#
# Each site is a directory under the mounted root (`/srv/sites/<slug>/`), written by
# scripts/package-website.py. `try_files $uri $uri/ /index.html` deliberately falls
# back to `/index.html` rather than 404: the sites are single-page apps built from
# one entry, and a deep link that answered 404 would look like a broken deploy.

server {
    listen       ${SITE_PORT};
    listen       [::]:${SITE_PORT};
    server_name  _;

    root  /srv/sites;
    index index.html;

    # Vite content-addresses its build output, so the hashed assets are safe to
    # cache hard. Matched per site, because the path is /<slug>/assets/... — a
    # plain `location /assets/` never matches and would silently do nothing.
    location ~ ^/[^/]+/assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        # The entry point must not be cached, or a republished site keeps serving
        # the previous build's HTML while its hashed assets have already changed.
        add_header Cache-Control "no-cache";
        # `=404`, NOT a fallback to `/index.html`. A fallback to a file that may not
        # exist is a redirect cycle when the site is missing, and nginx answers that
        # with a 500 and its own error page — measured here before this was fixed,
        # for the common case of a name published before its build was staged.
        try_files $uri $uri/ =404;
    }

    # A missing site is the common case, and nginx's stock 404 says nothing about
    # what to do. This says it.
    error_page 404 = @missing;

    location @missing {
        default_type text/plain;
        return 404 "No site is staged at this path. Publish one with: make site-package SLUG=<slug>\n";
    }
}
