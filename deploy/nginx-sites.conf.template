# olympus-sites — serve the staged static sites from `make site-package`.
#
# A TEMPLATE, not a config: the nginx image runs envsubst over files in
# /etc/nginx/templates/ on start, and compose sets NGINX_ENVSUBST_FILTER to
# `SITE_PORT|SITE_HOST_SUFFIX` so only those two are substituted. An unfiltered
# envsubst would also eat nginx's own `$uri` and `$site` here and blank out the
# routing — which is a site that serves nothing, with no error to point at.
#
# TWO SERVERS, AND THE FIRST ONE IS THE POINT.
#
#   * The wildcard vhost selects a site by HOSTNAME: the leftmost label of
#     <slug>.<suffix> is the directory under the sites root. That is what makes the
#     edge configurable as a plain forward to this port — no path rewriting, no
#     custom locations in NPM, one proxy host per published name.
#
#   * The catch-all serves the same tree by PATH (/<slug>/…) for anything that
#     arrives by address rather than by name — `curl http://127.0.0.1:SITE_PORT/
#     <slug>/`, which is how a site is checked before it has a name at all.
#
# Both are read-only over /srv/sites; nothing here writes.
#
# APPLICATIONS COME FIRST. A running Studio application gets one generated `server`
# block per slug, written by scripts/app-runtime.py into /etc/nginx/app-conf.d and
# included here. Its `server_name` is an exact name, and nginx resolves an exact name
# before it tries the wildcard regex below — so a name that is an app is proxied to
# that app's container, and every other name still falls through to the static tree.
# Nothing about this file changes when an application is published or removed; the
# include is the whole integration.
include /etc/nginx/app-conf.d/*.conf;

# --- by hostname: <slug>.SITE_HOST_SUFFIX (static) --------------------------
server {
    listen       ${SITE_PORT};
    listen  [::]:${SITE_PORT};
    server_name  ~^(?<site>[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)\.${SITE_HOST_SUFFIX}$;

    root  /srv/sites/$site;
    index index.html;

    # Vite content-addresses its build output, so the hashed assets are safe to
    # cache hard. The entry point is not, or a republished site keeps serving the
    # previous build's HTML while its hashed assets have already changed.
    location /assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        # `=404`, NOT a fallback to `/index.html`. A fallback to a file that may
        # not exist is a redirect cycle when the site is missing, which nginx
        # reports as a 500 with its own error page — measured here, for the common
        # case of a name published before its build was staged.
        try_files $uri $uri/ =404;
    }

    error_page 404 = @missing;
    location @missing {
        default_type text/plain;
        return 404 "No site is staged for $host. Publish one with: make site-publish SLUG=<slug>\n";
    }
}

# --- by path: /<slug>/… (default server) ------------------------------------
server {
    listen       ${SITE_PORT} default_server;
    listen  [::]:${SITE_PORT} default_server;
    server_name  _;

    root  /srv/sites;
    index index.html;

    location ~ ^/[^/]+/assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }

    error_page 404 = @missing;
    location @missing {
        default_type text/plain;
        return 404 "No site is staged at this path. Stage one with: make site-package SLUG=<slug>\n";
    }
}
