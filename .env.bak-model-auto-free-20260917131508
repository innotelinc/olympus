# --- Cerulean Vault (SecretOps — HashiCorp Vault, KV v2) --------------------
# Secrets live in Vault; `.env` carries references, not values:
#   OMNIROUTE_INITIAL_PASSWORD=vault://cerulean/olympus#INITIAL_PASSWORD
# `vault://<mount>/<path>#<key>` is the convention Cerulean resolves at startup,
# so the stack and the platform agree on one format.
#
# On the Cerulean platform Vault already runs as `cerulean-vault` — consume it
# rather than starting another one; never use the root token in
# ./data/vault/init/init.json (0600).
#
# Cerulean's default `cerulean` policy covers <prefix>/data/*, which every
# product sharing the mount can use to read and overwrite the others' secrets.
# Point VAULT_TOKEN_FILE at a token carrying THIS stack's path-scoped `olympus`
# policy instead. The platform's Vault bootstrap mints it — it is the file named
# by VAULT_PRODUCT_TOKENS=olympus over there — and renews it; `make vault-renew`
# renews it from this side too. Copy it over when it is created or re-minted.
#   Then: python3 scripts/vault-bootstrap.py
# For a checkout with no platform Vault, compose.vault.yml provides a dev-mode
# one (in-memory — local iteration only; read the header of that file first).
VAULT_ADDR=

VAULT_TOKEN=

# Preferred over VAULT_TOKEN: a file that both the Vault CLI and this stack read.
VAULT_TOKEN_FILE=./data/vault/token/olympus.token

# KV v2 mount point. Cerulean's default is `cerulean`.
VAULT_PREFIX=cerulean

# Path under the mount where this stack's secrets are stored.
VAULT_PATH=olympus

VAULT_NAMESPACE=

# "1" accepts a self-signed certificate; VAULT_CACERT pins a CA instead.
VAULT_SKIP_VERIFY=

VAULT_CACERT=

